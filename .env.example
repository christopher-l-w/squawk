# Copy to `.env` at the repo root. Used by apps/api and drizzle-kit.

DATABASE_URL=postgresql://squawk:squawk@localhost:5432/squawk

# API dev server
PORT=3001

# Allowed browser origin for CORS + cookies (Vite dev server)
WEB_ORIGIN=http://localhost:5173

# Web app: also copy `apps/web/.env.example` to `apps/web/.env` and set VITE_API_URL
# (same host/port as the API, e.g. http://localhost:3001).

# --- Optional: Sign in with Google (OAuth 2) ---
# Create OAuth 2.0 credentials in Google Cloud Console; add authorized redirect URI:
#   http://localhost:3001/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/auth/oauth/google/callback
